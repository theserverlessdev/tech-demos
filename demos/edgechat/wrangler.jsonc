{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-edgechat",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-edgechat",
      "database_id": "7c3de818-470f-445a-90c7-399d03c686c3",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "42b3d8c6974d464a97d0d55079a0fb71"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tech-demos-edgechat"
    }
  ],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "7351", "simple": { "limit": 40, "period": 60 } }
  ],
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/edgechat*", "zone_name": "theserverless.dev" },
    { "pattern": "edgechat.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
