{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-byok-playground",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-byok-playground",
      "database_id": "0593592b-fe69-419e-8fff-82a3725a9ee6",
      "migrations_dir": "migrations"
    }
  ],
  // 7461–7464 are unused elsewhere in this repo.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "7461", "simple": { "limit": 20, "period": 60 } },
    { "name": "MODELS_LIMIT", "namespace_id": "7462", "simple": { "limit": 20, "period": 60 } },
    { "name": "COMPARE_LIMIT", "namespace_id": "7463", "simple": { "limit": 8, "period": 60 } },
    { "name": "SESSION_LIMIT", "namespace_id": "7464", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.2-1b-instruct",
    "DAILY_COMPARE_CAP": "200",
    "IP_COMPARE_CAP": "12",
    // Empty in production. .dev.vars / wrangler.local.jsonc set "local" so
    // wrangler dev (which rewrites Host to the first route) can use test keys
    // and allow http://localhost to the mock OpenAI server.
    "ENVIRONMENT": "",
    // Shared widget. A placeholder such as REPLACE_ME still fails closed off localhost.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRUoj5qDpf7XyIW"
  },
  "secrets": { "required": ["TURNSTILE_SECRET", "IP_HASH_SECRET", "SESSION_SECRET"] },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/byok-playground*", "zone_name": "theserverless.dev" },
    { "pattern": "byok-playground.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": false }
  }
}
