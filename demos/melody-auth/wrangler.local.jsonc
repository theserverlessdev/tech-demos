{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-melody-auth",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-melody-auth",
      "database_id": "00000000-0000-4000-8000-000000007471",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KEYS",
      "id": "00000000000000000000000000007471"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "7481", "simple": { "limit": 8, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "7482", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "7483", "simple": { "limit": 60, "period": 60 } },
    { "name": "SESSION_LIMIT", "namespace_id": "7484", "simple": { "limit": 30, "period": 60 } },
    { "name": "PAGE_LIMIT", "namespace_id": "7485", "simple": { "limit": 30, "period": 60 } },
    { "name": "REG_LIMIT", "namespace_id": "7486", "simple": { "limit": 8, "period": 60 } },
    { "name": "DEVICE_LIMIT", "namespace_id": "7487", "simple": { "limit": 20, "period": 60 } },
    { "name": "INTROSPECT_LIMIT", "namespace_id": "7488", "simple": { "limit": 30, "period": 60 } },
    { "name": "REVOKE_LIMIT", "namespace_id": "7489", "simple": { "limit": 20, "period": 60 } },
    { "name": "FED_LIMIT", "namespace_id": "7490", "simple": { "limit": 12, "period": 60 } },
    { "name": "PAR_LIMIT", "namespace_id": "7491", "simple": { "limit": 20, "period": 60 } },
    { "name": "PLAY_LIMIT", "namespace_id": "7492", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "secrets": { "required": ["TURNSTILE_SECRET", "AUTH_PRIVATE_JWK"] },
  "workers_dev": false
}
