{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-melody-auth",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-melody-auth",
      "database_id": "00000000-0000-4000-8000-000000007471",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KEYS",
      "id": "00000000000000000000000000007471"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "7471", "simple": { "limit": 8, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "7472", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "7473", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "secrets": { "required": ["TURNSTILE_SECRET", "AUTH_PRIVATE_JWK"] },
  "workers_dev": false
}
