{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-repo-per-agent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "tech-demos",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-repo-per-agent",
      "database_id": "94497718-3138-4506-a005-0c91bcc80f0e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TaskAgent", "class_name": "TaskAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskAgent"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7381", "simple": { "limit": 4, "period": 60 } },
    { "name": "RUN_LIMIT", "namespace_id": "7382", "simple": { "limit": 6, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "7383", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "7384", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "TASK_TTL_SECONDS": "21600",
    "MAX_TASKS_PER_VISITOR": "3",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRUoj5qDpf7XyIW"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/repo-per-agent*", "zone_name": "theserverless.dev" },
    { "pattern": "repo-per-agent.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
