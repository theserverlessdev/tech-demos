{
  "name": "@tech-demos/goodvibes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client/app.ts --outdir public/assets --target browser --minify",
    "dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cf-typegen": "wrangler types",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/three": "^0.175.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  }
}
