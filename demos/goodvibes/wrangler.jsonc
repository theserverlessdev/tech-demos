{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-goodvibes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "VibeRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VibeRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7371", "simple": { "limit": 8, "period": 60 } }
  ],
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/goodvibes*", "zone_name": "theserverless.dev" },
    { "pattern": "goodvibes.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
