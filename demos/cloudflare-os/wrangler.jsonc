{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-cloudflare-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "Workspace" },
      { "name": "METER", "class_name": "Meter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace", "Meter"] }],
  "ratelimits": [
    { "name": "AGENT_LIMIT", "namespace_id": "7301", "simple": { "limit": 6, "period": 60 } },
    { "name": "CODE_LIMIT", "namespace_id": "7302", "simple": { "limit": 12, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "AI_DAILY_BUDGET_USD": "0.15",
    "DYNAMIC_WORKER_DAILY_CAP": "60"
  },
  // Blueprint files ship as text so the Workspace can hand them to the Worker Loader.
  "rules": [{ "type": "Text", "globs": ["**/blueprints/**/*.js", "**/blueprints/**/*.md", "**/*.txt"], "fallthrough": true }],
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/cloudflare-os*", "zone_name": "theserverless.dev" },
    { "pattern": "cloudflare-os.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
