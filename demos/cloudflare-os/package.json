{
  "name": "@tech-demos/cloudflare-os",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "mkdir -p src/client/gen && cp node_modules/capnweb/dist/index.js src/client/gen/capnweb.txt && bun build src/client/shell.ts --outdir public/assets --target browser --minify",
    "dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "capnweb": "0.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  }
}
