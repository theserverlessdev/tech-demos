{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-company-brain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ORG", "class_name": "Org" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Org"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7341", "simple": { "limit": 8, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "7342", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "7343", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "7344", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "ORG_TTL_HOURS": "24",
    // Cloudflare's published always-pass test site key. Replace before a public deploy
    // and set TURNSTILE_SECRET with `wrangler secret put`. The test secret is rejected
    // off localhost, so shipping this site key alone does not open production.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/company-brain*", "zone_name": "theserverless.dev" },
    { "pattern": "company-brain.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
