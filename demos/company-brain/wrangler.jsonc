{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-company-brain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ORG", "class_name": "Org" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Org"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7361", "simple": { "limit": 8, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "7362", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "7363", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "7364", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "ORG_TTL_HOURS": "24",
    // Public widget key for the live hostnames. TURNSTILE_SECRET is a Worker secret,
    // not a var. The always-pass test site key stays in wrangler.offline.jsonc.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRgqMzH6CzLSrXW"
  },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/company-brain*", "zone_name": "theserverless.dev" },
    { "pattern": "company-brain.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
