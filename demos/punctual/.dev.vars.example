# Local / self-host secrets. Do not commit real keys.
# bunx wrangler secret put RESEND_API_KEY
# bunx wrangler secret put ADMIN_API_KEY
# bunx wrangler secret put SIGNING_SECRET
# bunx wrangler secret put TURNSTILE_SECRET_KEY   # optional

ADMIN_API_KEY=dev-admin-key
SIGNING_SECRET=dev-signing-secret
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local screenshot hook (JSON busy intervals). Leave empty for D1-only.
GOOGLE_MOCK_BUSY=
PUBLIC_ORIGIN=http://127.0.0.1:8787
