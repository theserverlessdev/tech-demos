{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-resolve-hq",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-resolve-hq",
      "database_id": "23aec099-e775-4074-9f1c-dabc38f90b4e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tech-demos-resolve-hq"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND",
        "queue": "tech-demos-resolve-hq-inbound"
      }
    ],
    "consumers": [
      {
        "queue": "tech-demos-resolve-hq-inbound",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3
      }
    ]
  },
  // 7331 already shipped. New ids are 7530–7533 only.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "7331", "simple": { "limit": 20, "period": 60 } },
    { "name": "SESSION_LIMIT", "namespace_id": "7530", "simple": { "limit": 10, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "7531", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "7532", "simple": { "limit": 6, "period": 60 } },
    { "name": "HEALTH_LIMIT", "namespace_id": "7533", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["23 * * * *"] },
  "secrets": { "required": ["TURNSTILE_SECRET", "SESSION_SECRET"] },
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    // Analog of upstream DEV_MAIL_MODE=capture: inbound is Queue-simulated, not Email Routing.
    "DEV_MAIL_MODE": "queue",
    // Empty in production. wrangler.local.jsonc / .dev.vars set "local".
    "ENVIRONMENT": "",
    "DAILY_DRAFT_CAP": "80",
    "IP_DRAFT_CAP": "8",
    // Owner step — do not commit a real key here. Create a Turnstile widget that allows
    // tech-demos.theserverless.dev and resolve-hq.tech-demos.theserverless.dev, then replace this.
    "TURNSTILE_SITE_KEY": "REPLACE_ME"
  },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/resolve-hq*", "zone_name": "theserverless.dev" },
    { "pattern": "resolve-hq.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
