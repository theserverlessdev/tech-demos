{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-resolve-hq",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-resolve-hq",
      "database_id": "23aec099-e775-4074-9f1c-dabc38f90b4e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tech-demos-resolve-hq"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOUND",
        "queue": "tech-demos-resolve-hq-inbound"
      }
    ],
    "consumers": [
      {
        "queue": "tech-demos-resolve-hq-inbound",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3
      }
    ]
  },
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "7331", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    // Analog of upstream DEV_MAIL_MODE=capture: inbound is Queue-simulated, not Email Routing.
    "DEV_MAIL_MODE": "queue"
  },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/resolve-hq*", "zone_name": "theserverless.dev" },
    { "pattern": "resolve-hq.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
