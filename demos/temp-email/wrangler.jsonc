{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temp-email",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "dev": { "port": 8797 },
  "limits": { "cpu_ms": 5000 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "temp-email"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temp-email",
      // No database_id: wrangler 4.45+ will not auto-create D1 when the id is all zeros.
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1002", "simple": { "limit": 90, "period": 60 } },
    { "name": "SMTP_LIMIT", "namespace_id": "7550", "simple": { "limit": 30, "period": 60 } },
    { "name": "GATE_LIMIT", "namespace_id": "7551", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEB_CREATE_LIMIT", "namespace_id": "7552", "simple": { "limit": 2, "period": 60 } }
  ],
  "vars": {
    "MAIL_DOMAIN": "mail.example.com",
    "PUBLIC_ORIGIN": "https://temp-email.example.com",
    "WEB_TTL_MINUTES": "60",
    "MAX_TTL_MINUTES": "1440",
    "HOSTED_MODE": "false",
    "TURNSTILE_SITE_KEY": ""
  },
  "secrets": { "required": ["AGENT_API_KEY", "TURNSTILE_SECRET_KEY"] },
  // Secrets: AGENT_API_KEY (your admin/fleet key), TURNSTILE_SECRET_KEY
  "triggers": { "crons": ["*/15 * * * *"] },
  "workers_dev": true,
  "observability": { "enabled": true }
}
