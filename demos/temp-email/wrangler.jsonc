{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-temp-email",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tech-demos-temp-email"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-temp-email",
      "database_id": "c41b5408-e3fd-44d4-9455-f355016b483b",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7321", "simple": { "limit": 6, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "7322", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": {
    "MAIL_DOMAIN": "email.lomvic.com",
    "PUBLIC_ORIGIN": "https://email.lomvic.com",
    "WEB_TTL_MINUTES": "60",
    "MAX_TTL_MINUTES": "1440",
    // Hosted public demo. Self-host: set "false" and use wrangler.selfhost.jsonc.
    "HOSTED_MODE": "true",
    // Public Turnstile site key. Secret is TURNSTILE_SECRET_KEY (wrangler secret put).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEwRTER6EMQiuBqw"
  },
  // Secrets (never commit): AGENT_API_KEY (admin/fleet only), TURNSTILE_SECRET_KEY
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "email.lomvic.com", "custom_domain": true },
    { "pattern": "tech-demos.theserverless.dev/demos/temp-email*", "zone_name": "theserverless.dev" },
    { "pattern": "temp-email.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
