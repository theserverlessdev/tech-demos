# Local secrets for wrangler dev. Copy to .dev.vars (gitignored).
# Dummy Turnstile secret always passes. Production keys reject dummy tokens.
# Config (MAIL_DOMAIN, HOSTED_MODE, TURNSTILE_SITE_KEY) lives in wrangler.jsonc.
# `bun run dev` passes PUBLIC_ORIGIN and the dummy site key as --var.

AGENT_API_KEY=dev-agent-key-change-me
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
