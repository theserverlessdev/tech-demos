{
  "name": "@tech-demos/partyserver",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client/app.ts --outdir public/assets --target browser --minify",
    "dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cf-typegen": "wrangler types",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "partyserver": "^0.5.0",
    "partysocket": "^1.1.5",
    "y-partyserver": "2.2.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  }
}
