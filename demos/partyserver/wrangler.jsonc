{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-partyserver",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "BoardRoom", "class_name": "BoardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "7411", "simple": { "limit": 8, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "7412", "simple": { "limit": 40, "period": 60 } }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "ROOM_TTL_MS": "7200000",
    "TURNSTILE_LOCAL": "0"
  },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/partyserver*", "zone_name": "theserverless.dev" },
    { "pattern": "partyserver.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
