{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-apollo-desk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "Apollo", "class_name": "Apollo" },
      { "name": "METER", "class_name": "Meter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Apollo", "Meter"] }],
  "ratelimits": [
    // 7311 is the original per-IP turn limiter. 7451–7464 are taken by later demos.
    { "name": "TURN_LIMIT", "namespace_id": "7311", "simple": { "limit": 10, "period": 60 } },
    { "name": "VISITOR_LIMIT", "namespace_id": "7465", "simple": { "limit": 8, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "7466", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
    "STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "TTS_MODEL": "@cf/myshell-ai/melotts",
    "AI_DAILY_BUDGET_USD": "0.10",
    // Empty in production. .dev.vars sets "local" so the Turnstile test secret
    // works under wrangler dev, which rewrites Host to the first route.
    "ENVIRONMENT": "",
    // Public widget key. Local .dev.vars sets the always-pass test key.
    // Production needs a widget for tech-demos.theserverless.dev and apollo-desk.tech-demos.theserverless.dev.
    "TURNSTILE_SITE_KEY": ""
  },
  "secrets": { "required": ["TURNSTILE_SECRET"] },
  "routes": [
    { "pattern": "tech-demos.theserverless.dev/demos/apollo-desk*", "zone_name": "theserverless.dev" },
    { "pattern": "apollo-desk.tech-demos.theserverless.dev/*", "zone_name": "theserverless.dev" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
