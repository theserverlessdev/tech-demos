{
  "name": "@tech-demos/pairlane",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client/app.ts --outdir public/assets --target browser --minify",
    "dev": "bun run build && wrangler dev --port 8794 --var TURNSTILE_SITE_KEY:1x00000000000000000000AA --var TURNSTILE_LOCAL:1",
    "deploy": "bun run build && wrangler deploy",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:layout": "bun run build && bun run scripts/check-layout.ts",
    "verify:selfhost": "bun run scripts/verify-selfhost.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  }
}
