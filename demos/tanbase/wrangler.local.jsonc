{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Distinct from production `tech-demos-tanbase` so `wrangler deploy -c wrangler.local.jsonc` cannot overwrite the live worker.
  "name": "tech-demos-tanbase-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  // No Workers AI binding. Wrangler treats `ai` as remote-only and will not
  // boot `wrangler dev` until you log in. The split workflow takes the
  // labelled fallback path. Deploy uses wrangler.jsonc, which has the binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-demos-tanbase",
      "database_id": "67b63062-595d-48dc-a13c-2585dbeb5612",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tech-demos-tanbase"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  "workflows": [
    {
      "name": "tech-demos-tanbase-split",
      "binding": "SPLIT_TASK",
      "class_name": "SplitTaskWorkflow"
    }
  ],
  "ratelimits": [
    // Local only. Smoke's concurrency-cap probe needs room above production's 40/min.
    { "name": "WRITE_LIMIT", "namespace_id": "7540", "simple": { "limit": 200, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "7541", "simple": { "limit": 8, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "7542", "simple": { "limit": 4, "period": 60 } }
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET"]
  },
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3-flash",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ALLOW_LOCAL_HOOKS": ""
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
