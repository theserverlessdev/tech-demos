{
  "name": "@tech-demos/clef-gate",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client/app.ts --outdir public/assets --target browser --minify",
    "dev": "bun run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "bun run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "cf-typegen": "wrangler types",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "agents": "0.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.0"
  }
}
