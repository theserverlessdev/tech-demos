{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-demos-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/hello-dynamic/worker.js"],
      "fallthrough": true
    }
  ],
  "alias": {
    "@tech-demos/shared": "../../packages/shared/src/index.ts"
  },
  "routes": [
    {
      "pattern": "tech-demos.theserverless.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.tech-demos.theserverless.dev/*",
      "zone_name": "theserverless.dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}
